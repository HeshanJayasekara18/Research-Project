{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "query": "Me wetakolu video eke poththa saha dara ain karana eka gana viewers la monawada kiyanne?",
            "scope": {
              "video_id": "-3a4abtQH3E"
            }
          }
        ],
        "properties": {
          "candidates": {
            "default": 20,
            "description": "Retrieved candidates considered for evidence.",
            "maximum": 50.0,
            "minimum": 5.0,
            "title": "Candidates",
            "type": "integer"
          },
          "method": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RetrievalMethod"
              },
              {
                "type": "null"
              }
            ],
            "description": "Retrieval method. Default: multiview_hybrid if the LaBSE index is available, otherwise multiview_bm25."
          },
          "query": {
            "description": "Singlish, Sinhala or English question.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/AskScope"
          }
        },
        "required": [
          "query",
          "scope"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sinhala answer with [E#] labels; null unless status=\"answered\".",
            "title": "Answer"
          },
          "citations": {
            "description": "The supplied comments the answer cites (subset of evidence_supplied).",
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "title": "Citations",
            "type": "array"
          },
          "evidence_supplied": {
            "description": "Every comment sent to the model, in prompt order.",
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "title": "Evidence Supplied",
            "type": "array"
          },
          "generation": {
            "$ref": "#/components/schemas/GenerationInfo"
          },
          "insufficient_reason": {
            "anyOf": [
              {
                "enum": [
                  "no_content_term_match",
                  "model_declined"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Insufficient Reason"
          },
          "notice": {
            "title": "Notice",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalSummary"
          },
          "status": {
            "enum": [
              "answered",
              "insufficient_evidence"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "query",
          "status",
          "answer",
          "citations",
          "evidence_supplied",
          "retrieval",
          "generation",
          "notice"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "AskScope": {
        "additionalProperties": false,
        "properties": {
          "video_id": {
            "description": "Required: the answer is grounded only in this video's comments (filtered before ranking). A retrieval filter, NOT proof of ownership: the caller must authorise the user first.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id"
        ],
        "title": "AskScope",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Machine-readable, e.g. invalid_request, unauthorized, video_not_found, global_scope_disabled, method_unavailable, engine_not_ready, internal_error",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidenceItem": {
        "properties": {
          "comment_text": {
            "description": "Original comment text, unmodified.",
            "title": "Comment Text",
            "type": "string"
          },
          "document_id": {
            "description": "Internal surrogate document ID (not a YouTube comment ID).",
            "title": "Document Id",
            "type": "string"
          },
          "label": {
            "description": "Label shown to the model, e.g. \"E1\".",
            "title": "Label",
            "type": "string"
          },
          "matched_terms": {
            "description": "Query content terms found in the comment (why it was selected).",
            "items": {
              "type": "string"
            },
            "title": "Matched Terms",
            "type": "array"
          },
          "retrieval_rank": {
            "title": "Retrieval Rank",
            "type": "integer"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          },
          "video_reference": {
            "$ref": "#/components/schemas/VideoReference"
          }
        },
        "required": [
          "label",
          "document_id",
          "video_id",
          "comment_text",
          "retrieval_rank",
          "matched_terms",
          "video_reference"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "GenerationInfo": {
        "properties": {
          "called": {
            "description": "False when the pipeline stopped before calling the model.",
            "title": "Called",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "called"
        ],
        "title": "GenerationInfo",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "auth_enabled": {
            "title": "Auth Enabled",
            "type": "boolean"
          },
          "corpus_documents": {
            "title": "Corpus Documents",
            "type": "integer"
          },
          "engine_ready": {
            "title": "Engine Ready",
            "type": "boolean"
          },
          "llm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LLMStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "semantic": {
            "$ref": "#/components/schemas/SemanticStatus"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "videos": {
            "title": "Videos",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "api_version",
          "engine_ready",
          "corpus_documents",
          "videos",
          "semantic",
          "auth_enabled"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LLMStatus": {
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "description": "\"disabled\" or the configured provider, e.g. \"gemini\".",
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "enabled"
        ],
        "title": "LLMStatus",
        "type": "object"
      },
      "NormalizationInfo": {
        "properties": {
          "coverage": {
            "title": "Coverage",
            "type": "number"
          },
          "normalized_query": {
            "title": "Normalized Query",
            "type": "string"
          },
          "status": {
            "description": "normalized | partial | failed | unchanged | empty",
            "title": "Status",
            "type": "string"
          },
          "used": {
            "description": "Whether the normalised query was actually used for retrieval.",
            "title": "Used",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "normalized_query",
          "coverage",
          "used"
        ],
        "title": "NormalizationInfo",
        "type": "object"
      },
      "RetrievalMethod": {
        "description": "Stable API identifiers. Mapped to engine method names in the service layer.",
        "enum": [
          "bm25",
          "char_tfidf",
          "labse",
          "normalized_bm25",
          "normalized_labse",
          "multiview_bm25",
          "multiview_labse",
          "multiview_hybrid"
        ],
        "title": "RetrievalMethod",
        "type": "string"
      },
      "RetrievalSummary": {
        "properties": {
          "candidates_rejected_no_content_match": {
            "title": "Candidates Rejected No Content Match",
            "type": "integer"
          },
          "candidates_retrieved": {
            "title": "Candidates Retrieved",
            "type": "integer"
          },
          "candidates_selected": {
            "title": "Candidates Selected",
            "type": "integer"
          },
          "method": {
            "$ref": "#/components/schemas/RetrievalMethod"
          },
          "normalized_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Query"
          },
          "query_content_terms": {
            "items": {
              "type": "string"
            },
            "title": "Query Content Terms",
            "type": "array"
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeInfo"
          }
        },
        "required": [
          "method",
          "scope",
          "normalized_query",
          "query_content_terms",
          "candidates_retrieved",
          "candidates_selected",
          "candidates_rejected_no_content_match"
        ],
        "title": "RetrievalSummary",
        "type": "object"
      },
      "RetrieveRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "method": "bm25",
            "query": "Me wetakolu video eke poththa saha dara ain karana eka gana viewers la monawada kiyanne?",
            "scope": {
              "video_id": "-3a4abtQH3E"
            },
            "top_k": 5
          }
        ],
        "properties": {
          "method": {
            "$ref": "#/components/schemas/RetrievalMethod",
            "default": "bm25"
          },
          "query": {
            "description": "Singlish, Sinhala or English question.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/RetrieveScope"
          },
          "top_k": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "RetrieveRequest",
        "type": "object"
      },
      "RetrieveResponse": {
        "properties": {
          "method": {
            "$ref": "#/components/schemas/RetrievalMethod"
          },
          "normalization": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NormalizationInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "notice": {
            "description": "Results are retrieved candidates, not verified evidence or generated answers.",
            "title": "Notice",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "result_count": {
            "title": "Result Count",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievedComment"
            },
            "title": "Results",
            "type": "array"
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeInfo"
          },
          "top_k": {
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "request_id",
          "query",
          "method",
          "top_k",
          "scope",
          "results",
          "result_count",
          "notice"
        ],
        "title": "RetrieveResponse",
        "type": "object"
      },
      "RetrieveScope": {
        "additionalProperties": false,
        "properties": {
          "video_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Search ONLY this video's comments (filtering happens before ranking). null = global research corpus. This is a retrieval filter, NOT proof of ownership: the caller must authorise the user for this video before forwarding the request.",
            "title": "Video Id"
          }
        },
        "title": "RetrieveScope",
        "type": "object"
      },
      "RetrievedComment": {
        "properties": {
          "document_id": {
            "description": "Stable surrogate ID (not a YouTube comment ID).",
            "title": "Document Id",
            "type": "string"
          },
          "likes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Likes"
          },
          "rank": {
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "description": "Method-specific; compare only within one response.",
            "title": "Score",
            "type": "number"
          },
          "score_type": {
            "enum": [
              "bm25",
              "char_tfidf_cosine",
              "labse_cosine",
              "rrf"
            ],
            "title": "Score Type",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "video_id": {
            "title": "Video Id",
            "type": "string"
          },
          "video_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Video link; comment-level permalinks are not available.",
            "title": "Video Url"
          },
          "views": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ViewContribution"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Multi-view methods only.",
            "title": "Views"
          }
        },
        "required": [
          "rank",
          "document_id",
          "video_id",
          "text",
          "likes",
          "video_url",
          "score",
          "score_type"
        ],
        "title": "RetrievedComment",
        "type": "object"
      },
      "ScopeInfo": {
        "properties": {
          "documents_searched": {
            "title": "Documents Searched",
            "type": "integer"
          },
          "ownership_verified": {
            "const": false,
            "default": false,
            "description": "Always false: this service never verifies creator/channel ownership.",
            "title": "Ownership Verified",
            "type": "boolean"
          },
          "type": {
            "enum": [
              "video",
              "global"
            ],
            "title": "Type",
            "type": "string"
          },
          "video_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Id"
          }
        },
        "required": [
          "type",
          "video_id",
          "documents_searched"
        ],
        "title": "ScopeInfo",
        "type": "object"
      },
      "SemanticStatus": {
        "properties": {
          "index_present": {
            "title": "Index Present",
            "type": "boolean"
          },
          "loaded": {
            "title": "Loaded",
            "type": "boolean"
          }
        },
        "required": [
          "index_present",
          "loaded"
        ],
        "title": "SemanticStatus",
        "type": "object"
      },
      "VideoReference": {
        "properties": {
          "granularity": {
            "const": "video",
            "default": "video",
            "description": "Always \"video\": the dataset has no comment IDs, so this links the video, not the individual comment.",
            "title": "Granularity",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "url"
        ],
        "title": "VideoReference",
        "type": "object"
      },
      "ViewContribution": {
        "properties": {
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "view": {
            "description": "e.g. \"BM25/original\", \"LaBSE/normalized\"",
            "title": "View",
            "type": "string"
          }
        },
        "required": [
          "view",
          "rank",
          "score"
        ],
        "title": "ViewContribution",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Explainable RAG Knowledge Assistant - retrieval service (v1). Server-to-server API: call from Next.js Route Handlers or the team API gateway.",
    "title": "Singlish Retrieval Engine API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/ask": {
      "post": {
        "description": "Answer in Sinhala from the selected video's comments only, citing the exact comments used.\n\nReturns status \"insufficient_evidence\" instead of guessing. 503 llm_unavailable when no LLM is\nconfigured; 502 llm_error / llm_invalid_output / llm_unsupported_citation when the model fails or\ncites comments it was not given (the answer is then withheld).",
        "operationId": "askGrounded",
        "parameters": [
          {
            "in": "header",
            "name": "X-Service-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ask",
        "tags": [
          "rag"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Liveness/readiness. Unauthenticated; exposes no corpus content and never calls the LLM.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/retrieve": {
      "post": {
        "description": "Rank YouTube comments for a question, optionally scoped to one video (filter before ranking).",
        "operationId": "retrieveComments",
        "parameters": [
          {
            "in": "header",
            "name": "X-Service-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrieveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrieveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
