# Copy to .env (never commit .env). Placeholders only: no real credentials.
# Load with: python -m uvicorn rag_service.api.main:app --env-file .env

# development | test | production  (production refuses to start without RAG_SERVICE_API_KEY)
RAG_ENV=development

# Service-to-service secret: the Next.js server / API gateway sends it as the X-Service-Key header.
# It is NOT creator login or YouTube channel authorisation.
# Empty = no authentication: allowed ONLY for localhost development (--host 127.0.0.1).
# Must equal KNOWLEDGE_ASSISTANT_API_KEY in the Next.js server environment (never NEXT_PUBLIC_*).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_SERVICE_API_KEY=

# true = allow scope.video_id=null (global research corpus). Set false for the product deployment.
RAG_ALLOW_GLOBAL_SCOPE=true

# Comma-separated browser origins. Leave EMPTY: the API is meant for server-side calls only.
RAG_CORS_ORIGINS=

# Optional: folder holding comments_clean.csv / labse_index.npz (default: ./data)
# RAG_DATA_DIR=

# Optional: local folder or HF name of the LaBSE model (used by rag_service.retrieval.engine).
# SINGLISH_LABSE_MODEL=sentence-transformers/LaBSE
