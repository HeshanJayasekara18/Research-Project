# Copy to .env (never commit .env). Values here are placeholders.

# development | test | production  (production refuses to start without RAG_SERVICE_API_KEY)
RAG_ENV=development

# Shared secret the Next.js server / API gateway sends as the X-Service-Key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_SERVICE_API_KEY=

# true = allow scope.video_id=null (global research corpus). Set false for the product deployment.
RAG_ALLOW_GLOBAL_SCOPE=true

# Comma-separated browser origins. Leave EMPTY: the API is meant for server-side calls only.
RAG_CORS_ORIGINS=

# Optional: local folder or HF name of the LaBSE model (used by retrieval.py).
# SINGLISH_LABSE_MODEL=sentence-transformers/LaBSE
